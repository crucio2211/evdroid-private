+/* Longest forced stem this word starts with, or -1. One entry covers the
+   word and everything built on it -- produces, producing, candidate's --
+   because only the stem is replaced and the rest of the token stays on as
+   text after the annotation for the rules to read. */
+static int which_forced(const char *at, size_t n)
+{
+    int i;
+    int best = -1;
+    size_t bestlen = 0;
+
+    for (i = 0; i < FORCED; i++) {
+        size_t m = strlen(forced[i].word);
+
+        if (m > bestlen && m <= n
+            && strncasecmp(forced[i].word, at, m) == 0) {
+            best = i;
+            bestlen = m;
+        }
+    }
+    return best;
+}

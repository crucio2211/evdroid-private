hetero: forced whole words said as written, after the table

The heteronym table consults grammar; some words need no asking. A
forced word is replaced whole by its annotation when the table leaves
it alone, so inflections keep their endings for the rules to read and
no annotation is ever split by trailing text. Annotations are dotted
syllables with the stress digits, the only form the engine is measured
to honour; undotted strings are spoken as text.
Applied at build time so CI builds the same tree.
diff --git a/src/eci/hetero/eci_hetero.c b/src/eci/hetero/eci_hetero.c
index e9e6f85..d24d99e 100644
--- a/src/eci/hetero/eci_hetero.c
+++ b/src/eci/hetero/eci_hetero.c
@@ -87,6 +87,32 @@ static const Hetero words[] = {
 
 #define WORDS (int)(sizeof words / sizeof words[0])
 
+/* Words always said one way, whatever stands around them. Unlike the
+   heteronyms above these consult no grammar: the reading given here is
+   written in the word's place every time the heteronym table leaves it
+   alone, so a word whose dictionary entry cannot carry what it needs to
+   say is said from here instead and the entry goes away. Whole words
+   only: an inflection the table does not name falls back to the
+   dictionary and the rules, which is where its ending is read. */
+typedef struct {
+    const char *word;
+    const char *say;      /* the annotation written in its place */
+} Forced;
+
+static const Forced forced[] = {
+    { "candidate", "`[.1kA.0ndX.0det]" },
+    { "produce",   "`[.0prU.1dus]" },
+    { "unread",    "`[.0xnr.1Ed]" },
+    { "entries",   "`[.1en.0tryes]" },
+    { "cities",    "`[.1Ti.0tyes]" },
+    { "ladies",    "`[.1la.0dyes]" },
+    { "stories",   "`[.1sto.0ryes]" },
+    { "cookies",   "`[.0ko.1o.0kyes]" },
+    { "dictionaries", "`[.0dik.0tyo.1na.0ryes]" },
+};
+
+#define FORCED (int)(sizeof forced / sizeof forced[0])
+
 /* What the word before says about what this one is.
  *
  * The engine's own test looks no further than one word back and neither does
@@ -136,6 +162,19 @@ static int which(const char *at, size_t n)
     return -1;
 }
 
+/* Which of the forced words this word is, or -1. Whole words only, so
+   that an inflection keeps its own ending for the rules to read. */
+static int which_forced(const char *at, size_t n)
+{
+    int i;
+
+    for (i = 0; i < FORCED; i++)
+        if (strlen(forced[i].word) == n
+            && strncasecmp(forced[i].word, at, n) == 0)
+            return i;
+    return -1;
+}
+
 /* The word before the one at `at', as an offset and a length. Answers 0 when
    there is none. */
 static const char *word_before(const char *text, const char *at, size_t *n)
@@ -168,6 +207,12 @@ static size_t room_for(const char *text)
         if (b > most)
             most = b;
     }
+    for (i = 0; i < FORCED; i++) {
+        size_t a = strlen(forced[i].say);
+
+        if (a > most)
+            most = a;
+    }
     return strlen(text) * (most + 2) + 1;
 }
 
@@ -213,6 +258,18 @@ char *hetero_rewrite(const char *text)
                 continue;
             }
         }
+        /* The table left it alone: a forced word is said as written. */
+        {
+            int f = which_forced(start, n);
+
+            if (f >= 0) {
+                const char *say = forced[f].say;
+
+                memcpy(out + at, say, strlen(say));
+                at += strlen(say);
+                continue;
+            }
+        }
         memcpy(out + at, start, n);
         at += n;
     }

+/* Words always said one way, whatever stands around them. Unlike the
+   heteronyms above these consult no grammar: the reading given here is
+   written over the word's stem wherever the stem leads the token, so one
+   entry says the word and its inflections and possessives, and a word
+   whose dictionary entry cannot carry what it needs to say is said from
+   here instead and the entry goes away. */
+typedef struct {
+    const char *word;
+    const char *say;      /* the annotation written in its place */
+} Forced;
+
+static const Forced forced[] = {
+    { "candidate", "`[k1A1ndXd1et]" },
+    { "produce",   "`[prU1d1us]" },
+};
+
+#define FORCED (int)(sizeof forced / sizeof forced[0])
+
 /* What the word before says about what this one is.

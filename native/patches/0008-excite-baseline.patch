+/* ---- excitement for ! and ? ------------------------------------------ */
+
+/* The engine reads every sentence end the same: hello! comes out flat
+   where ETI shouts it, because the mark never reaches intonation -- the
+   intonation rules test for question records and never for bang, so a
+   final bang takes the declarative defaults. Until the rules learn the
+   mark, a final bang is handed over as a question: the question machinery
+   is proven (it rises), the phones do not move, and only the last mark
+   counts, past trailing space and closers. Mid-sentence bangs, which the
+   rules already shape, are left alone.
+ *
+ * An exclamation raises the pitch baseline on top of that, a question
+   less so; the excursions around it -- the inflection -- are left
+   exactly as they are, in the same `vb shape the caller-facing prosody
+   already sends every utterance, so a malformed one cannot slip in and
+   the next utterance's own numbers put everything back.
+ *
+ * Only the last mark of the text counts, and only for the utterance as
+   a whole. Answers a new buffer holding prefix plus text, or nought
+   when the text ends in anything else. All languages shout. */
+static char *excite_rewrite(const char *text, uint32_t len, uint32_t *newlen)
+{
+    uint32_t end = len;
+    const char *prefix = 0;
+    uint32_t pn = 0;
+    char *out;
+
+    if (text == 0 || len == 0)
+        return 0;
+    while (end > 0) {
+        unsigned char c = (unsigned char)text[end - 1];
+
+        if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '"'
+            || c == '\'' || c == ')' || c == ']' || c == '}')
+            end--;
+        else
+            break;
+    }
+    if (end == 0)
+        return 0;
+    if (text[end - 1] == '!') {
+        prefix = "`vb65 ";
+        pn = 6;
+    } else if (text[end - 1] == '?') {
+        prefix = "`vb58 ";
+        pn = 6;
+    } else {
+        return 0;
+    }
+    out = (char *)malloc(len + pn + 1);
+    if (out == 0)
+        return 0;
+    memcpy(out, prefix, pn);
+    memcpy(out + pn, text, len);
+    out[pn + len] = 0;
+    /* A final bang goes over as a question mark: same phones, working
+       rise. Both marks are one ASCII byte, so the swap is in place. */
+    if (text[end - 1] == '!')
+        out[pn + end - 1] = '?';
+    *newlen = pn + len;
+    return out;
+}
+

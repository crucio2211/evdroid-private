hetero: forced plain-word respellings after an emptied table

The heteronym table consults grammar but all of its readings are
bracket annotations this engine spells aloud instead of honouring,
measured, so the table stands empty and only whole-word plain
respellings remain. High bytes count as word bytes so an enye stays
inside its token for matching. Starts with nina said as niya, in
Western and UTF-8 bytes alike.
Applied at build time so CI builds the same tree.
diff --git a/src/eci/hetero/eci_hetero.c b/src/eci/hetero/eci_hetero.c
index e9e6f85..0231762 100644
--- a/src/eci/hetero/eci_hetero.c
+++ b/src/eci/hetero/eci_hetero.c
@@ -73,20 +73,37 @@ typedef struct {
 } Hetero;
 
 static const Hetero words[] = {
-    { "decrease",   "`[.1di.0kris]",      0                      },
-    { "digest",     0,                    "`[.0dX.1JEst]"        },
-    { "export",     0,                    "`[.0Ek.1spcrt]"       },
-    { "exports",    0,                    "`[.0Ek.1spcrts]"      },
-    { "produce",    "`[.1pro.0dus]",      0                      },
-    { "transfer",   0,                    "`[.0trAns.1fR]"       },
-    { "transfers",  0,                    "`[.0trAns.1fRz]"      },
-    { "transplant", 0,                    "`[.0trAnz.1plAnt]"    },
-    { "transport",  0,                    "`[.0trAn.1spcrt]"     },
-    { "transports", 0,                    "`[.0trAn.1spcrts]"    },
+    { "", 0, 0 },
 };
 
 #define WORDS (int)(sizeof words / sizeof words[0])
 
+/* Words always said one way, whatever stands around them. Unlike the
+   heteronyms above these consult no grammar: the reading given here is
+   written in the word's place every time the heteronym table leaves it
+   alone. Whole words only, so that an inflection keeps its own ending
+   for the rules to read.
+ *
+ * Plain words, never annotations: this engine spells `[phone]
+ * pronunciations aloud instead of honouring them, measured on both the
+ * phoneme and the synthesis path, so an annotation here would read as
+ * garbage. A plain respelling reads through the ordinary rules, which is
+ * what makes it safe.
+ *
+ * The heteronym table above stands empty for the same reason: every one
+ * of its readings is an annotation this engine would spell. */
+typedef struct {
+    const char *word;
+    const char *say;      /* the plain respelling written in its place */
+} Forced;
+
+static const Forced forced[] = {
+    { "ni\xf1a", "niya" },
+    { "ni\xc3\xb1a", "niya" },
+};
+
+#define FORCED (int)(sizeof forced / sizeof forced[0])
+
 /* What the word before says about what this one is.
  *
  * The engine's own test looks no further than one word back and neither does
@@ -120,8 +137,12 @@ static int among(const char *word, size_t n, const char *const *list)
 
 static int is_word_byte(char c)
 {
-    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
-        || (c >= '0' && c <= '9') || c == '\'';
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+        || (c >= '0' && c <= '9') || c == '\'')
+        return 1;
+    /* High bytes too, so a word holding an enye stays one token for the
+       matching below. ASCII text is unaffected. */
+    return (unsigned char)c >= 0x80;
 }
 
 /* Which of the table this word is, or -1. */
@@ -136,6 +157,19 @@ static int which(const char *at, size_t n)
     return -1;
 }
 
+/* Which of the forced words this word is, or -1. Whole words only, so
+   that an inflection keeps its own ending for the rules to read. */
+static int which_forced(const char *at, size_t n)
+{
+    int i;
+
+    for (i = 0; i < FORCED; i++)
+        if (strlen(forced[i].word) == n
+            && strncasecmp(forced[i].word, at, n) == 0)
+            return i;
+    return -1;
+}
+
 /* The word before the one at `at', as an offset and a length. Answers 0 when
    there is none. */
 static const char *word_before(const char *text, const char *at, size_t *n)
@@ -168,6 +202,12 @@ static size_t room_for(const char *text)
         if (b > most)
             most = b;
     }
+    for (i = 0; i < FORCED; i++) {
+        size_t a = strlen(forced[i].say);
+
+        if (a > most)
+            most = a;
+    }
     return strlen(text) * (most + 2) + 1;
 }
 
@@ -213,6 +253,18 @@ char *hetero_rewrite(const char *text)
                 continue;
             }
         }
+        /* The table left it alone: a forced word is said as written. */
+        {
+            int f = which_forced(start, n);
+
+            if (f >= 0) {
+                const char *say = forced[f].say;
+
+                memcpy(out + at, say, strlen(say));
+                at += strlen(say);
+                continue;
+            }
+        }
         memcpy(out + at, start, n);
         at += n;
     }

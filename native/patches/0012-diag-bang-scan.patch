DIAGNOSTIC: boundary scan looks for bang instead of question

Adds lower-form wrapper ZZtestFldeq5_1_5 (type 5 = bang, twin of the
5_1_3 question wrapper) and points eng_boundary_tone's scan at it.
If final hey! gains expression while hey? flattens, the scan drives
the rise and the real fix accepts both marks. Revert after the ear test.
diff --git a/lang/enus/rules/es_inton.dr b/lang/enus/rules/es_inton.dr
index 169a662..b3d9bae 100644
--- a/lang/enus/rules/es_inton.dr
+++ b/lang/enus/rules/es_inton.dr
@@ -1122,7 +1122,7 @@ label L3 was $X8$100770
   cmp testl reg r0 reg r0
   branch jne to L13
   push reg r6
-  call ZZtestFldeq5_1_3 arity 1 depth 1
+  call ZZtestFldeq5_1_5 arity 1 depth 1
   cmp testl reg r0 reg r0
   popreg r1
   branch jne to L1
diff --git a/lang/enus/rules/glob.dr b/lang/enus/rules/glob.dr
index 4a9336b..a8ab6a2 100644
--- a/lang/enus/rules/glob.dr
+++ b/lang/enus/rules/glob.dr
@@ -30958,3 +30958,14 @@ label L1 was at_0x1d
   return imm 1
 end
 
+rule ZZtestFldeq5_1_5 from glob.obj
+shape frame 0 argbase 8 params 1
+label L0 was _ZZtestFldeq5_1_5
+  push imm 5
+  push imm 1
+  push imm 5
+  push param 0
+  call testFldeq arity 4 depth 4
+  popn 4
+  return reg r0
+end

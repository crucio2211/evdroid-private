engine: baseline lift for !/? plus the enye glide

Utterance-final ! raises the pitch baseline, ? less so; inflection(fluctuation) is never touched. ETI shouts hello! where we read it flat.
Enye in either English goes in as ny (eeny after i, oony after u).
All languages shout. Applied at build time so CI builds the same tree.
diff --git a/src/eci/synth/eci_synthtext.c b/src/eci/synth/eci_synthtext.c
index fb97f8e..90cb7f9 100644
--- a/src/eci/synth/eci_synthtext.c
+++ b/src/eci/synth/eci_synthtext.c
@@ -339,6 +339,182 @@ static int utf8ToWestern(const char *text, uint32_t len, char *out,
     return 1;
 }
 
+/* ---- excitement for ! and ? ------------------------------------------ */
+
+/* The engine reads every sentence end the same: hello! comes out flat
+   where ETI shouts it, because the mark never reaches intonation. An
+   exclamation raises the pitch baseline, a question less so; the
+   excursions around it -- the inflection -- are left exactly as they
+   are, in the same `vb shape the caller-facing prosody already sends
+   every utterance, so a malformed one cannot slip in and the next
+   utterance's own numbers put everything back.
+ *
+ * Only the last mark of the text counts, past trailing space and
+   closers, and only for the utterance as a whole. Answers a new buffer
+   holding prefix plus text, or nought when the text ends in anything
+   else. All languages shout. */
+static char *excite_rewrite(const char *text, uint32_t len, uint32_t *newlen)
+{
+    uint32_t end = len;
+    const char *prefix = 0;
+    uint32_t pn = 0;
+    char *out;
+
+    if (text == 0 || len == 0)
+        return 0;
+    while (end > 0) {
+        unsigned char c = (unsigned char)text[end - 1];
+
+        if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '"'
+            || c == '\'' || c == ')' || c == ']' || c == '}')
+            end--;
+        else
+            break;
+    }
+    if (end == 0)
+        return 0;
+    if (text[end - 1] == '!') {
+        prefix = "`vb65 ";
+        pn = 6;
+    } else if (text[end - 1] == '?') {
+        prefix = "`vb58 ";
+        pn = 6;
+    } else {
+        return 0;
+    }
+    out = (char *)malloc(len + pn + 1);
+    if (out == 0)
+        return 0;
+    memcpy(out, prefix, pn);
+    memcpy(out + pn, text, len);
+    out[pn + len] = 0;
+    *newlen = pn + len;
+    return out;
+}
+
+/* ---- enye in English words ------------------------------------------- */
+
+/* Whether this Western byte can stand inside a word: letters and digits in
+   both cases, and the high half that holds the accented letters. The
+   multiplication and division signs are punctuation wherever they stand. */
+static int enye_word_byte(unsigned char c)
+{
+    if ((c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z')
+        || (c >= 'a' && c <= 'z'))
+        return 1;
+    return c >= 0xc0 && c != 0xd7 && c != 0xf7;
+}
+
+/* US and British English have no letter for the palatal nasal, and folding the enye to
+   a plain n or a bare glide both misread it: pinata on one side, pee-ya on
+   the other. The way ordinary words spell the sound is "ny" after a vowel
+   left open, the way canyon and Kenya spell it, and the engine answers the
+   one phone for it. An "i" closes into "in" before a nasal, and a "u"
+   yods into "myun", so the two go in long, "ee" and "oo", the way
+   "neenya" reads nee-nya and "moonya" moo-nya; any other letter stands as
+   it is. Standing alone the enye is the letter's name already, through
+   dictionary eng_char_name, and is left alone.
+ *
+ * Takes UTF-8 or Western bytes and answers Western ones, since either may
+ * arrive and the machine reads one set. An annotation passes through
+ * untouched: a backquote runs to the next whitespace, which covers voice
+ * changes, pauses and the bracketed pronunciations alike, none of which
+ * holds an enye of its own.
+ *
+ * Answers a new buffer holding the rewrite, or nought when the text holds
+ * no enye at all, which is the common case and costs nothing. The buffer
+ * is twice the text and one over, since a vowel plus enye goes out as
+ * four letters; nothing longer can come of it. */
+static char *enye_rewrite_english(const char *text, uint32_t len,
+                               uint32_t *newlen)
+{
+    uint32_t i;
+    char *out;
+    char *o;
+
+    if (text == 0 || len == 0)
+        return 0;
+    for (i = 0; i < len; i++) {
+        unsigned char c = (unsigned char)text[i];
+
+        if (c == 0xf1 || c == 0xd1 || c == 0xc3)
+            break;
+    }
+    if (i >= len)
+        return 0;
+    out = (char *)malloc(len * 2 + 1);
+    if (out == 0)
+        return 0;
+    o = out;
+    i = 0;
+    while (i < len) {
+        unsigned char c = (unsigned char)text[i];
+        unsigned char d = i + 1 < len ? (unsigned char)text[i + 1] : 0;
+        int unit = 0;
+        int upper = 0;
+
+        if (c == 0xf1) {
+            unit = 1;
+        } else if (c == 0xd1) {
+            unit = 1;
+            upper = 1;
+        } else if (c == 0xc3 && (d == 0xb1 || d == 0x91)) {
+            unit = 2;
+            upper = d == 0x91;
+        }
+        if (unit == 0) {
+            /* An annotation runs to the next whitespace. */
+            if (c == '`') {
+                while (i < len && text[i] != 0 && text[i] != ' '
+                       && text[i] != '\t' && text[i] != '\n'
+                       && text[i] != '\r')
+                    *o++ = text[i++];
+                continue;
+            }
+            *o++ = text[i++];
+            continue;
+        }
+        {
+            int before = i > 0 && enye_word_byte((unsigned char)text[i - 1]);
+            int after = i + (uint32_t)unit < len
+                && enye_word_byte((unsigned char)text[i + unit]);
+
+            if (before || after) {
+                /* In a word the enye goes in as "ny": with the nasal in
+                   it, not the bare glide. After an "i" or "u" the pair
+                   goes in long, "eeny" and "oony", so the syllable stays
+                   open and the vowel keeps its name. */
+                if (o > out && (o[-1] == 'i' || o[-1] == 'I'
+                                || o[-1] == 'u' || o[-1] == 'U')) {
+                    char v = o[-1];
+                    char e = 'e';
+
+                    if (v == 'I')
+                        e = 'E';
+                    else if (v == 'u')
+                        e = 'o';
+                    else if (v == 'U')
+                        e = 'O';
+                    o--;
+                    *o++ = e;
+                    *o++ = e;
+                }
+                *o++ = upper ? 'N' : 'n';
+                *o++ = upper ? 'Y' : 'y';
+            } else {
+                uint32_t k;
+
+                for (k = 0; k < (uint32_t)unit; k++)
+                    *o++ = text[i + k];
+            }
+            i += (uint32_t)unit;
+        }
+    }
+    *o = 0;
+    *newlen = (uint32_t)(o - out);
+    return out;
+}
+

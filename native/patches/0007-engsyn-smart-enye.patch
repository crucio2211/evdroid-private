+/* ---- WORD-LEVEL EÑE PHONETIC PREPROCESSOR ----------------------------- */
+
+static char *filter_smart_enye(const char *text)
+{
+    size_t len, r, w;
+    char *buf;
+
+    if (!text)
+        return 0;
+
+    len = strlen(text);
+    if (len == 0)
+        return 0;
+
+    /* Headroom para sa string expansion */
+    buf = (char *)malloc(len * 4 + 1);
+    if (!buf)
+        return 0;
+
+    r = 0;
+    w = 0;
+    while (r < len) {
+        unsigned char c1 = (unsigned char)text[r];
+        unsigned char c2 = (r + 1 < len) ? (unsigned char)text[r + 1] : 0;
+        int is_enye = 0;
+        int char_len = 1;
+        int is_upper = 0;
+
+        /* Pagtukoy sa UTF-8 (\xC3\xB1 / \xC3\x91) o ANSI (0xF1 / 0xD1) */
+        if (c1 == 0xC3 && c2 == 0xB1) { is_enye = 1; char_len = 2; }
+        else if (c1 == 0xC3 && c2 == 0x91) { is_enye = 1; char_len = 2; is_upper = 1; }
+        else if (c1 == 0xF1) { is_enye = 1; char_len = 1; }
+        else if (c1 == 0xD1) { is_enye = 1; char_len = 1; is_upper = 1; }
+
+        if (is_enye) {
+            unsigned char prev = (r > 0) ? (unsigned char)text[r - 1] : ' ';
+            unsigned char next = (r + char_len < len) ? (unsigned char)text[r + char_len] : ' ';
+
+            int has_prev_letter = isalpha(prev);
+            int has_next_letter = isalpha(next);
+
+            /* CASE 1: Standalone eñe (nag-iisa) -> Hayaan as-is para sa screen reader echo */
+            if (!has_prev_letter && !has_next_letter) {
+                buf[w++] = text[r++];
+                if (char_len == 2)
+                    buf[w++] = text[r++];
+            }
+            /* CASE 2: Simula ng salita bago ang 'a' (tulad ng "ña") -> "nyah" para single syllable */
+            else if (!has_prev_letter && tolower(next) == 'a') {
+                buf[w++] = is_upper ? 'N' : 'n';
+                buf[w++] = 'y';
+                buf[w++] = 'a';
+                buf[w++] = 'h';
+                r += char_len + 1;
+            }
+            /* CASE 3: Nasa loob ng salita (tulad ng niño, baño, piñata, Parañaque) -> "ny" */
+            else {
+                buf[w++] = is_upper ? 'N' : 'n';
+                buf[w++] = 'y';
+                r += char_len;
+            }
+        } else {
+            buf[w++] = text[r++];
+        }
+    }
+    buf[w] = '\0';
+    return buf;
+}

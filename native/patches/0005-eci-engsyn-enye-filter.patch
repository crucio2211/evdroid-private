+/* ---- ENYE FILTER / PRE-PROCESSOR -------------------------------------- */
+
+static char *filter_text_enye(const char *text)
+{
+    size_t len, r, w;
+    char *buf;
+
+    if (!text)
+        return 0;
+
+    len = strlen(text);
+    if (len == 0)
+        return 0;
+
+    /* Standalone lowercase 'enye' (Latin-1 0xF1 or UTF-8 \xC3\xB1) */
+    if ((len == 1 && (unsigned char)text[0] == 0xF1) ||
+        (len == 2 && (unsigned char)text[0] == 0xC3 && (unsigned char)text[1] == 0xB1)) {
+        char *res = (char *)malloc(5);
+        if (res)
+            strcpy(res, "enye");
+        return res;
+    }
+
+    /* Standalone uppercase 'Enye' (Latin-1 0xD1 or UTF-8 \xC3\x91) */
+    if ((len == 1 && (unsigned char)text[0] == 0xD1) ||
+        (len == 2 && (unsigned char)text[0] == 0xC3 && (unsigned char)text[1] == 0x91)) {
+        char *res = (char *)malloc(5);
+        if (res)
+            strcpy(res, "Enye");
+        return res;
+    }
+
+    /* Allocate buffer with enough headroom (worst-case: enye expands 1 to 2 chars) */
+    buf = (char *)malloc(len * 2 + 1);
+    if (!buf)
+        return 0;
+
+    r = 0;
+    w = 0;
+    while (r < len) {
+        unsigned char c1 = (unsigned char)text[r];
+        unsigned char c2 = (r + 1 < len) ? (unsigned char)text[r + 1] : 0;
+
+        /* UTF-8: lowercase enye (\xC3\xB1) -> "ny" */
+        if (c1 == 0xC3 && c2 == 0xB1) {
+            buf[w++] = 'n';
+            buf[w++] = 'y';
+            r += 2;
+        }
+        /* UTF-8: uppercase Enye (\xC3\x91) -> "Ny" */
+        else if (c1 == 0xC3 && c2 == 0x91) {
+            buf[w++] = 'N';
+            buf[w++] = 'y';
+            r += 2;
+        }
+        /* ANSI / Latin-1 / CP1252: lowercase enye (0xF1) -> "ny" */
+        else if (c1 == 0xF1) {
+            buf[w++] = 'n';
+            buf[w++] = 'y';
+            r++;
+        }
+        /* ANSI / Latin-1 / CP1252: uppercase Enye (0xD1) -> "Ny" */
+        else if (c1 == 0xD1) {
+            buf[w++] = 'N';
+            buf[w++] = 'y';
+            r++;
+        }
+        else {
+            buf[w++] = text[r++];
+        }
+    }
+    buf[w] = '\0';
+    return buf;
+}
